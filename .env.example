# ==============================================================================
# Dynamic Remote Camera Streaming + AI Platform - Environment Configuration
# ==============================================================================
# Copy this file to .env and configure for your environment.
# In production, ensure all secrets are replaced with cryptographically strong values.

# ------------------------------------------------------------------------------
# 1. APPLICATION
# ------------------------------------------------------------------------------
APP_ENV=development                   # development | production | testing
APP_NAME="Dynamic Remote Camera & AI Platform"
DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
PUBLIC_API_URL=http://localhost:8000  # Publicly accessible URL for the API

# ------------------------------------------------------------------------------
# 2. DATABASE (MongoDB / MongoDB Atlas)
# ------------------------------------------------------------------------------
MONGODB_URI="mongodb://127.0.0.1:27017" # or mongodb+srv://<user>:<password>@cluster.mongodb.net
MONGODB_DATABASE=camera_ai_platform

# ------------------------------------------------------------------------------
# 3. AUTH & SECURITY
# ------------------------------------------------------------------------------
JWT_SECRET=change_this_to_a_random_32_character_secret_key_minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

COOKIE_NAME=camera_session
COOKIE_SECURE=false                   # Set true in HTTPS production
COOKIE_HTTP_ONLY=true
COOKIE_SAMESITE=lax

# Symmetric key for encrypting camera credentials at rest (Fernet URL-safe base64 or min 16 chars)
CAMERA_ENCRYPTION_KEY=GsN70SjxmJEaPzDVKCgOHRCp1rpu_cOdgLzNLV_37Wo

# ------------------------------------------------------------------------------
# 4. MEDIAMTX (Streaming Core)
# ------------------------------------------------------------------------------
MEDIAMTX_HOST=127.0.0.1
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_WEBRTC_PORT=8889
MEDIAMTX_HLS_PORT=8888
MEDIAMTX_API_URL=http://127.0.0.1:9997

# Public URLs returned to browsers (No localhost in production)
PUBLIC_WEBRTC_URL=http://localhost:8889
PUBLIC_HLS_URL=http://localhost:8888

# MediaMTX internal users
MEDIAMTX_PUBLISH_USERNAME=edge_publisher
MEDIAMTX_PUBLISH_PASSWORD=dev_mediamtx_pub_pwd_secure
MEDIAMTX_READ_USERNAME=webrtc_reader
MEDIAMTX_READ_PASSWORD=dev_mediamtx_read_pwd_secure

# ------------------------------------------------------------------------------
# 5. STREAMING (FFmpeg Ingestion Engine)
# ------------------------------------------------------------------------------
FFMPEG_BINARY=ffmpeg
FFMPEG_ENCODER=libx264                # libx264 (universal CPU), h264_amf (AMD GPU), h264_nvenc (NVIDIA), copy (passthrough)
STREAM_RESOLUTION=1280x720
STREAM_FPS=15.0
STREAM_BITRATE=1M

# ------------------------------------------------------------------------------
# 6. AI PIPELINE & SAGEMAKER
# ------------------------------------------------------------------------------
AI_ENABLED=true
AI_MODEL_NAME=yolo
AI_INFERENCE_INTERVAL=1.0             # Seconds between inference sampling (e.g. 1.0 = 1 FPS)
AI_MIN_CONFIDENCE=0.35                # Minimum detection confidence threshold (0.0 - 1.0)
AI_MOCK_FALLBACK=true                 # Run simulated/local inference if SageMaker is unreachable

# ------------------------------------------------------------------------------
# 7. AWS CONFIGURATION
# ------------------------------------------------------------------------------
SAGEMAKER_REGION=us-east-1
SAGEMAKER_ENDPOINT_NAME=yolo26s-cctv-endpoint
# AWS credentials (leave blank if running on EC2/ECS with IAM role)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------------------
# 8. CORS
# ------------------------------------------------------------------------------
# Comma-separated allowed frontend origins
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 9. RETENTION & CLEANUP
# ------------------------------------------------------------------------------
DETECTION_RETENTION_DAYS=30           # Days to retain detection events in MongoDB
RETENTION_CLEANUP_HOURS=24            # Interval for retention cleanup job

# ------------------------------------------------------------------------------
# 10. REMOTE EDGE GATEWAY
# ------------------------------------------------------------------------------
# Shared secret for edge/agent.py authentication (store only in .env, never in git)
EDGE_GATEWAY_TOKEN=
# Organization whose remote-edge cameras this gateway serves
EDGE_GATEWAY_ORG_ID=
# Public hostname/IP edge workers use to publish RTSP into MediaMTX
MEDIAMTX_PUBLISH_HOST=
REMOTE_EDGE_STATUS_INTERVAL_SECONDS=15
